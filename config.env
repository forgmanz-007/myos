# ─────────────────────────────────────────────────────────────────────────────
#  Build settings for your OS. Edit this file, then run ./build.sh
#  (Lines starting with # are comments.)
# ─────────────────────────────────────────────────────────────────────────────

# Name shown in the boot menu, the installer and "About this System".
OS_NAME="MyOS"

# Short id: lowercase letters and digits only. Used for file names.
OS_ID="myos"

# Debian release to build on. trixie = Debian 13 (the current stable release).
DEBIAN_RELEASE="trixie"

# Kernel:
#   backports = newer kernel and firmware (best for a brand-new PC)
#   stable    = Debian's standard long-term kernel
KERNEL="backports"

# Which AI model to use: DeepSeek, Qwen, or any model from ollama.com/library.
# The first-start screen offers this model for download. Leave empty and
# DeepSeek Shell suggests the best DeepSeek model for your graphics card.
# You can switch at any time in DeepSeek Shell > Settings > AI model.
# DeepSeek: deepseek-r1:8b (5.2 GB)   deepseek-r1:32b (20 GB)
# Qwen:     qwen3.5:9b (about 7 GB)   qwen3.8:27b (18 GB)
DEFAULT_MODEL=""

# Put the AI model inside the ISO so the AI works offline from the first boot.
# The ISO gets much bigger (about +5 GB for deepseek-r1:8b).
# If DEFAULT_MODEL is empty, deepseek-r1:8b is bundled.
BUNDLE_MODEL="no"

# Bundle AMD graphics card acceleration (ROCm) for the AI engine (+ about 1.5 GB).
# NVIDIA needs nothing here: the AI installs the NVIDIA driver after the first boot.
AMD_GPU_SUPPORT="no"

# Use a specific Ollama (AI engine) version, for example "0.40.14". Empty = latest.
OLLAMA_VERSION=""

# ── Windows programs (.exe) ───────────────────────────────────────────────────
# File Explorer (KDE's Dolphin, shown as "File Explorer" in the Start menu and
# pinned to the taskbar). You need it to open an .exe's Properties and switch
# Proton on. It also makes Win+E work. Set to "no" for a pure 4-app system.
FILE_MANAGER="yes"

# Put GE-Proton inside the ISO so "Run with Proton" works offline (+ about 1 GB).
# With "no", Proton is downloaded the first time you use it.
BUNDLE_PROTON="yes"

# A specific GE-Proton release, for example "GE-Proton10-25". Empty = latest.
PROTON_VERSION=""

# ── Video wallpapers ─────────────────────────────────────────────────────────
# Lets you use a video as your desktop wallpaper (right-click a video >
# "Set as Wallpaper", or ask the AI). Uses the "Smart Video Wallpaper Reborn"
# plugin, which pauses the video while a window is maximized to save power.
VIDEO_WALLPAPERS="yes"

# A specific plugin release, for example "v2.17.0". Empty = latest.
VIDEO_WALLPAPER_VERSION=""

# Bundle today's ClamAV virus signatures so protection works from the first
# boot (+ about 250 MB). They update automatically every day either way.
CLAMAV_SIGNATURES="yes"

# Extra Debian packages to preinstall. You can also just ask the AI to
# install these later. Popular choices, with the Windows equivalent:
#   konsole              Terminal
#   kde-spectacle        Snipping Tool (makes Win+Shift+S and PrtScn work)
#   kate                 Notepad
#   gwenview             Photos
#   okular               PDF reader
#   ark                  Zip files
#   kcalc                Calculator
EXTRA_PACKAGES=""

# Language and keyboard of the live USB session (the installer asks again).
LIVE_LOCALE="en_US.UTF-8"
LIVE_KEYBOARD="us"
