<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>DeepSeek Shell</vendor>

  <!-- A command the user approved in DeepSeek Shell. Needs the password;
       it is remembered for a few minutes so a multi-step fix does not ask
       again and again. -->
  <action id="org.myos.deepseekshell.run-as-root">
    <description>Run a system command for DeepSeek Shell</description>
    <message>DeepSeek Shell wants to change your system. Check the command shown in DeepSeek Shell, then enter your password to allow it.</message>
    <icon_name>deepseek-shell</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXECDIR@/run-as-root</annotate>
  </action>

  <!-- Reading system logs only. -->
  <action id="org.myos.deepseekshell.diagnostics">
    <description>Let DeepSeek Shell read the system logs</description>
    <message>DeepSeek Shell wants to read the system logs to look for problems.</message>
    <icon_name>deepseek-shell</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXECDIR@/diag-helper</annotate>
  </action>
</policyconfig>
