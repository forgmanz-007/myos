#!/bin/bash
# Optional: put the DeepSeek model inside the image (BUNDLE_MODEL=yes).
set -euo pipefail
. /etc/myos/build.conf
[ "$BUNDLE_MODEL" = yes ] || exit 0

MODELS=/usr/share/ollama/.ollama/models
install -d -o ollama -g ollama "$MODELS"
OLLAMA_MODELS=$MODELS OLLAMA_HOST=127.0.0.1:11555 /usr/local/bin/ollama serve >/tmp/ollama-build.log 2>&1 &
pid=$!
for _ in $(seq 1 60); do
    curl -fsS http://127.0.0.1:11555/api/version >/dev/null 2>&1 && break
    sleep 1
done
OLLAMA_HOST=127.0.0.1:11555 /usr/local/bin/ollama pull "$DEFAULT_MODEL"
kill "$pid"; wait "$pid" 2>/dev/null || true
chown -R ollama:ollama /usr/share/ollama/.ollama
rm -f /tmp/ollama-build.log
