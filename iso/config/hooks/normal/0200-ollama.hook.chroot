#!/bin/bash
# Ollama: the local AI engine that runs the DeepSeek models.
set -euo pipefail
. /etc/myos/build.conf

BASE=https://ollama.com/download
VER=${OLLAMA_VERSION:+?version=$OLLAMA_VERSION}

fetch() {
    local name=$1
    if curl -fsSIL --retry 3 "$BASE/$name.tar.zst$VER" >/dev/null 2>&1; then
        echo "Downloading $name.tar.zst"
        curl -fSL --retry 3 "$BASE/$name.tar.zst$VER" | zstd -dc | tar -xf - -C /usr/local
    else
        echo "Downloading $name.tgz"
        curl -fSL --retry 3 "$BASE/$name.tgz$VER" | tar -xzf - -C /usr/local
    fi
}

rm -rf /usr/local/lib/ollama
install -d -m 0755 /usr/local/lib/ollama
fetch ollama-linux-amd64
if [ "$AMD_GPU_SUPPORT" = yes ]; then
    fetch ollama-linux-amd64-rocm
fi
test -x /usr/local/bin/ollama

if ! id ollama >/dev/null 2>&1; then
    useradd -r -s /usr/sbin/nologin -U -m -d /usr/share/ollama ollama
fi
for g in render video; do
    if getent group "$g" >/dev/null; then usermod -a -G "$g" ollama; fi
done
systemctl enable ollama.service
